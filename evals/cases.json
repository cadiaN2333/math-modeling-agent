{
  "version": 1,
  "scope": "员工排班、连续单目标线性规划和整数单商品最小费用网络流；其他网络流仍测试能力边界",
  "cases": [
    {
      "id": "clarify_missing_employee_max_hours",
      "family": "scheduling",
      "request": "我需要安排两个各8小时班次，每班至少一人；林晓有急救技能，且必须安排在第一班。现阶段还没有整理出其他员工名单和每个人的最大总工时，请告诉我还需要补充哪些信息，暂时不要假设员工或直接求解。",
      "expected_analysis_status": "needs_clarification",
      "required_text_groups": [
        {
          "fields": ["missing_information", "clarifying_questions"],
          "any_of": ["最大总工时", "最大工时", "工时上限", "最多工作"]
        }
      ]
    },
    {
      "id": "schedule_three_staff_feasible",
      "family": "scheduling",
      "request": "本次排班只有两个班次。员工有E1林晓、E2陈立、E3周宁，三人最大工时都是8小时；只有林晓有急救技能。两个班次各8小时，每班至少一人；第一班至少需要一名急救员，第二班无额外技能要求。不考虑班次重叠和员工不可用时间。",
      "expected_analysis_status": "ready",
      "expected_model": {
        "employees": [
          {"employee_id": "E1", "name": "林晓", "skills": ["急救"], "max_hours": 8.0},
          {"employee_id": "E2", "name": "陈立", "skills": [], "max_hours": 8.0},
          {"employee_id": "E3", "name": "周宁", "skills": [], "max_hours": 8.0}
        ],
        "shifts": [
          {"shift_id": "S1", "duration_hours": 8.0},
          {"shift_id": "S2", "duration_hours": 8.0}
        ],
        "coverage_requirements": [
          {
            "shift_id": "S1",
            "minimum_employees": 1,
            "skill_requirements": [{"skill": "急救", "minimum_count": 1}]
          },
          {"shift_id": "S2", "minimum_employees": 1, "skill_requirements": []}
        ]
      },
      "expected_solver_statuses": ["OPTIMAL", "FEASIBLE"],
      "expected_method_id": "cp_sat_scheduling",
      "expected_validation": "valid",
      "required_assignment_pairs": [["E1", "S1"]]
    },
    {
      "id": "schedule_infeasible_missing_first_aid_skill",
      "family": "scheduling",
      "request": "两名员工E1陈立和E2周宁都没有急救技能，最大工时各8小时。安排两个各8小时班次，每班至少一人；第一班至少需要一名急救员，第二班没有技能要求。",
      "expected_analysis_status": "ready",
      "expected_solver_statuses": ["INFEASIBLE"],
      "expected_method_id": "cp_sat_scheduling",
      "expected_validation": "not_run"
    },
    {
      "id": "schedule_infeasible_hours_below_shift_duration",
      "family": "scheduling",
      "request": "员工E1林晓有急救技能、最多工作7小时；员工E2陈立没有急救技能、最多工作7小时。安排两个各8小时班次，每班至少一人；第一班需要一名急救员，第二班没有额外技能要求。",
      "expected_analysis_status": "ready",
      "expected_solver_statuses": ["INFEASIBLE"],
      "expected_method_id": "cp_sat_scheduling",
      "expected_validation": "not_run"
    },
    {
      "id": "unsupported_shift_time_overlap",
      "family": "scheduling",
      "request": "安排E1林晓和E2陈立，二人最多工作8小时。S1是08:00到16:00，S2是14:00到22:00，每班至少一人，并保证同一员工不能被安排到时间重叠的班次。",
      "expected_analysis_status": "unsupported",
      "required_text_groups": [
        {
          "fields": ["unsupported_reasons"],
          "any_of": ["班次起止时间", "班次时间", "时间重叠", "重叠约束"]
        }
      ]
    },
    {
      "id": "unsupported_wage_and_fairness_objectives",
      "family": "scheduling",
      "request": "给E1林晓和E2陈立安排一个8小时班次，二人最多工作8小时；要求满足覆盖的同时最小化工资成本，并让两个人的排班时长尽量公平。",
      "expected_analysis_status": "unsupported",
      "required_text_groups": [
        {"fields": ["unsupported_reasons"], "any_of": ["工资", "薪资", "成本"]},
        {"fields": ["unsupported_reasons"], "any_of": ["公平", "均衡"]}
      ]
    },
    {
      "id": "linear_programming_production_plan",
      "family": "linear_programming",
      "request": "工厂生产A、B两种产品，产量变量均为连续变量并以件计，且不得为负；单位利润分别为40元和30元，单位产品消耗工时分别为2小时和1小时，每件A和B均消耗1单位原料。每天最多有100小时工时和80单位原料，求利润最大的产量组合。",
      "expected_analysis_status": "ready",
      "expected_model": {
        "variables": [
          {"name": "A", "unit": "件"},
          {"name": "B", "unit": "件"}
        ],
        "objective_direction": "maximize",
        "objective_terms": [
          {"variable": "A", "coefficient": 40.0},
          {"variable": "B", "coefficient": 30.0}
        ],
        "constraints": [
          {
            "constraint_id": "labor",
            "terms": [
              {"variable": "A", "coefficient": 2.0},
              {"variable": "B", "coefficient": 1.0}
            ],
            "relation": "<=",
            "rhs": 100.0
          },
          {
            "constraint_id": "material",
            "terms": [
              {"variable": "A", "coefficient": 1.0},
              {"variable": "B", "coefficient": 1.0}
            ],
            "relation": "<=",
            "rhs": 80.0
          },
          {
            "constraint_id": "A_nonnegative",
            "terms": [{"variable": "A", "coefficient": 1.0}],
            "relation": ">=",
            "rhs": 0.0
          },
          {
            "constraint_id": "B_nonnegative",
            "terms": [{"variable": "B", "coefficient": 1.0}],
            "relation": ">=",
            "rhs": 0.0
          }
        ]
      },
      "expected_solver_statuses": ["OPTIMAL"],
      "expected_method_id": "continuous_linear_programming",
      "expected_validation": "valid",
      "expected_variable_values": {"A": 20.0, "B": 60.0},
      "expected_objective_value": 2600.0
    },
    {
      "id": "linear_programming_infeasible_constraints",
      "family": "linear_programming",
      "request": "令连续变量x表示以件计的产量，目标是最小化x；同时要求x至少为10且至多为5，判断是否存在可行方案。",
      "expected_analysis_status": "ready",
      "expected_model": {
        "variables": [{"name": "x", "unit": "件"}],
        "objective_direction": "minimize",
        "objective_terms": [{"variable": "x", "coefficient": 1.0}],
        "constraints": [
          {
            "constraint_id": "minimum",
            "terms": [{"variable": "x", "coefficient": 1.0}],
            "relation": ">=",
            "rhs": 10.0
          },
          {
            "constraint_id": "maximum",
            "terms": [{"variable": "x", "coefficient": 1.0}],
            "relation": "<=",
            "rhs": 5.0
          }
        ]
      },
      "expected_solver_statuses": ["INFEASIBLE"],
      "expected_method_id": "continuous_linear_programming",
      "expected_validation": "not_run"
    },
    {
      "id": "minimum_cost_flow_warehouse_delivery",
      "family": "transportation",
      "request": "运输按整数箱计，费用按元/箱计。仓库W1（仓库一）供给20箱，仓库W2（仓库二）供给30箱；门店S1（门店一）需求25箱，门店S2（门店二）需求25箱。可用路线只有W1到S1（容量20，单位运费2）、W1到S2（容量20，单位运费4）、W2到S1（容量25，单位运费3）、W2到S2（容量30，单位运费1）。必须满足全部门店需求，求最低总运费。",
      "expected_analysis_status": "ready",
      "expected_model": {
        "nodes": [
          {"node_id": "W1", "name": "仓库一", "supply": 20},
          {"node_id": "W2", "name": "仓库二", "supply": 30},
          {"node_id": "S1", "name": "门店一", "supply": -25},
          {"node_id": "S2", "name": "门店二", "supply": -25}
        ],
        "arcs": [
          {"arc_id": "W1_S1", "from_node": "W1", "to_node": "S1", "capacity": 20, "unit_cost": 2},
          {"arc_id": "W1_S2", "from_node": "W1", "to_node": "S2", "capacity": 20, "unit_cost": 4},
          {"arc_id": "W2_S1", "from_node": "W2", "to_node": "S1", "capacity": 25, "unit_cost": 3},
          {"arc_id": "W2_S2", "from_node": "W2", "to_node": "S2", "capacity": 30, "unit_cost": 1}
        ],
        "flow_unit": "箱",
        "cost_unit": "元/箱"
      },
      "expected_solver_statuses": ["OPTIMAL"],
      "expected_method_id": "minimum_cost_flow",
      "expected_validation": "valid",
      "expected_route_flows": [
        ["W1", "S1", 20],
        ["W1", "S2", 0],
        ["W2", "S1", 5],
        ["W2", "S2", 25]
      ],
      "expected_total_cost": 80
    },
    {
      "id": "minimum_cost_flow_infeasible_capacity",
      "family": "transportation",
      "request": "运输按整数箱计，费用按元/箱计。仓库W1（仓库一）供给20箱、W2（仓库二）供给30箱；门店S1（门店一）需求25箱、S2（门店二）需求25箱。路线只有W1到S1（容量10，单位运费2）、W2到S1（容量25，单位运费3）、W2到S2（容量30，单位运费1）。必须满足全部需求，判断是否存在可行运输方案。",
      "expected_analysis_status": "ready",
      "expected_model": {
        "nodes": [
          {"node_id": "W1", "name": "仓库一", "supply": 20},
          {"node_id": "W2", "name": "仓库二", "supply": 30},
          {"node_id": "S1", "name": "门店一", "supply": -25},
          {"node_id": "S2", "name": "门店二", "supply": -25}
        ],
        "arcs": [
          {"arc_id": "W1_S1", "from_node": "W1", "to_node": "S1", "capacity": 10, "unit_cost": 2},
          {"arc_id": "W2_S1", "from_node": "W2", "to_node": "S1", "capacity": 25, "unit_cost": 3},
          {"arc_id": "W2_S2", "from_node": "W2", "to_node": "S2", "capacity": 30, "unit_cost": 1}
        ],
        "flow_unit": "箱",
        "cost_unit": "元/箱"
      },
      "expected_solver_statuses": ["INFEASIBLE"],
      "expected_method_id": "minimum_cost_flow",
      "expected_validation": "not_run"
    },
    {
      "id": "unsupported_multicommodity_flow",
      "family": "transportation",
      "request": "在仓库和门店网络中同时配送商品A和商品B，两种商品有不同供需量，但共享每条路线的容量；要求满足各商品需求并最小化总运费。",
      "expected_analysis_status": "unsupported",
      "required_text_groups": [
        {
          "fields": ["unsupported_reasons"],
          "any_of": ["多商品流", "多商品", "共享容量"]
        }
      ]
    }
  ]
}
